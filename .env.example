# NyayaAccess — Environment Configuration Template
# Copy this file to .env (or server/.env and client/.env) and fill in real values.
# NEVER commit real secret values to Git.

# --- Backend Server Configuration ---
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# --- Supabase Database & Auth (Optional for demo mode / when implemented) ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- LLM Inference Service (Groq / DigitalOcean / OpenAI-compatible) ---
# GROQ_API_KEY=gsk_your_groq_api_key
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_API_URL=https://api.groq.com/openai/v1
#
# (Alternative: DigitalOcean Serverless Inference)
# DIGITALOCEAN_INFERENCE_URL=https://inference.digitalocean.com/v1
# DIGITALOCEAN_INFERENCE_API_KEY=your-digitalocean-inference-key
# DIGITALOCEAN_MODEL=meta-llama/Llama-3.3-70B-Instruct
# LLM_TIMEOUT_MS=30000

# --- Request Validation & Safety Limits ---
# MAX_MESSAGE_LENGTH=2000

# --- Frontend Configuration (Vite) ---
# VITE_API_BASE_URL=http://localhost:5000
